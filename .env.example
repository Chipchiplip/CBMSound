# Google Cloud OAuth client ID for a Web application. Public by design.
VITE_GOOGLE_CLIENT_ID=

# Google Picker: required to authorize the existing root folder with drive.file.
# Public browser API key, restricted to Google Picker API and allowed referrers.
VITE_GOOGLE_PICKER_API_KEY=
# Numeric Project Number (not the textual Project ID), same project as OAuth.
VITE_GOOGLE_CLOUD_PROJECT_NUMBER=

# Fixed shared root. Do not create another folder when authorization fails.
VITE_DRIVE_FOLDER_ID=1_GEZPONNMBfSzvVs2tFHDiCp40fNjREB

# For a GitHub project site named CBMSound, set /CBMSound/.
# Set / for USERNAME.github.io or a custom domain.
VITE_BASE_PATH=/

# Offer an explicit drive.readonly consent button for existing music/listeners.
# drive.file may only list files already authorized to the application.
# This grants read access to the account's entire Drive; the app queries only
# direct audio children of the configured root. Never requested automatically.
VITE_ALLOW_LISTENER_READONLY_FALLBACK=true
